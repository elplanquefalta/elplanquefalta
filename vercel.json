{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/asesoria",
      "destination": "/contacto",
      "permanent": false
    },
    {
      "source": "/sobre-mi",
      "destination": "/contacto#sobre-mi",
      "permanent": false
    },
    {
      "source": "/aviso_privacidad.pdf",
      "destination": "/aviso-de-privacidad",
      "permanent": false
    },
    {
      "source": "/img/(.*)\\.png",
      "destination": "/img/$1.jpg",
      "permanent": false
    }
  ]
}
